# Chaves do backend (Lovable Cloud / Supabase).
# Os valores abaixo são PÚBLICOS por design (chave publishable/anon).
# NUNCA coloque aqui a chave de serviço (SUPABASE_SERVICE_ROLE_KEY):
# essa chave só existe no painel do backend e deve ir para as variáveis
# de ambiente do Vercel, nunca para o GitHub.

# --- Leitura no navegador (build do front) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXX"
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

# --- Leitura no servidor (funções de servidor) ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXX"

# --- Somente para "Criar acesso para atendente" (servidor) ---
# Chave de serviço: adicionar apenas no Vercel (Environment Variables),
# nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=""
